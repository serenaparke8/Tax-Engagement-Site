TEM_ENV=development
# Production demo accounts are provisioned interactively with provision_demo_accounts.py;
# these example-only account settings support local SQLite development seeding.
TEM_DATABASE_URL=postgresql+psycopg://replace-with-user:replace-with-password@replace-with-host/replace-with-database
TEM_SECRET_KEY=replace-with-a-unique-random-secret
TEM_DEMO_ACCOUNT_1_USERNAME=replace-with-demo-username
TEM_DEMO_ACCOUNT_1_PASSWORD=replace-with-private-demo-password
TEM_DEMO_ACCOUNT_1_DISPLAY_NAME=replace-with-display-name
TEM_DEMO_ACCOUNT_2_USERNAME=replace-with-another-demo-username
TEM_DEMO_ACCOUNT_2_PASSWORD=replace-with-another-private-demo-password
TEM_DEMO_ACCOUNT_2_DISPLAY_NAME=replace-with-another-display-name
