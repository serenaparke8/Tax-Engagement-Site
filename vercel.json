{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "tems_frontend": {
      "root": "frontend/"
    },
    "tems_backend": {
      "root": "backend/",
      "entrypoint": "run:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "tems_backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "tems_frontend" }
    }
  ]
}
